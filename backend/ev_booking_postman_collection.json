          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings/check/availability?stationId=station-1&chargerId=s1-c1&date=2026-08-17",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings",
                "check",
                "availability"
              ],
              "query": [
                {
                  "key": "stationId",
                  "value": "station-1"
                },
                {
                  "key": "chargerId",
                  "value": "s1-c1"
                },
                {
                  "key": "date",
                  "value": "2026-08-17"
                }
              ]
            },
            "description": "Checks which slots are already booked on a charger for a date."
          },
          "response": []
        },
        {
          "name": "Create a Successful Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"booking_id\", jsonData.data.id);",
                  "    console.log(\"Saved booking_id environment variable: \" + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stationId\": \"station-1\",\n  \"chargerId\": \"s1-c1\",\n  \"userName\": \"Rahul Sharma\",\n  \"userEmail\": \"rahul@example.com\",\n  \"userPhone\": \"9876543210\",\n  \"vehicleModel\": \"Tata Nexon EV Max\",\n  \"vehicleNumber\": \"KA-03-MR-4567\",\n  \"date\": \"2026-08-18\",\n  \"timeSlot\": \"12:00 - 14:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "description": "Send a valid request to reserve a slot. If successful, it automatically saves the booking ID to the collection variables for subsequent update/fetch/cancel tests."
          },
          "response": []
        },
